table DimYear
	lineageTag: 1a03dcba-215b-5e40-a763-944b9ed00bae

	column year
		dataType: int64
		formatString: 0
		lineageTag: 366ff6f6-a3ce-5a66-93d5-d7560bf593cf
		summarizeBy: none
		sourceColumn: year

	column is_main_asean_window
		dataType: int64
		formatString: 0
		lineageTag: 0a09f743-4f43-53e5-8037-8a5ec48c66f9
		summarizeBy: none
		sourceColumn: is_main_asean_window

	partition DimYear = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        File.Contents( pCleanFolder & "\dim_year.csv" ),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    Promoted = Table.PromoteHeaders( Source, [PromoteAllScalars = true] ),
				    Typed = Table.TransformColumnTypes(
				        Promoted,
				        {{"year", Int64.Type}, {"is_main_asean_window", Int64.Type}},
				        "en-US"
				    )
				in
				    Typed

