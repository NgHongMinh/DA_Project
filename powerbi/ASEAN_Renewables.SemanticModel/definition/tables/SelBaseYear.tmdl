table SelBaseYear
	lineageTag: 2892d6f2-d05b-5055-a376-67acc9a5754f

	column year
		dataType: int64
		formatString: 0
		lineageTag: 806de61e-f861-58f6-83b4-661ef1f2f800
		summarizeBy: none
		sourceColumn: [year]

	partition SelBaseYear = calculated
		mode: import
		source =
			SELECTCOLUMNS(
			    GENERATESERIES( 2000, 2021, 1 ),
			    "year", [Value]
			)
