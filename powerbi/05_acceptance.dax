)


// ---- Gate B9 -- text results (9 cells) ----
EVALUATE
UNION(
    ROW( "test_id", "P5_B9_TOP1_SHARE_MODERN_WIND_SOLAR_2000", "actual_text", CALCULATE( [Concentration Status], SelReportYear[year] = 2000, SelMode[mode_key] = "MODERN_WIND_SOLAR" ) & "" ),
    ROW( "test_id", "P5_B9_TOP3_SHARE_MODERN_WIND_SOLAR_2000", "actual_text", CALCULATE( [Concentration Status], SelReportYear[year] = 2000, SelMode[mode_key] = "MODERN_WIND_SOLAR" ) & "" ),
    ROW( "test_id", "P5_B9_HHI_MODERN_WIND_SOLAR_2000", "actual_text", CALCULATE( [Concentration Status], SelReportYear[year] = 2000, SelMode[mode_key] = "MODERN_WIND_SOLAR" ) & "" ),
    ROW( "test_id", "P5_B9_GINI_MODERN_WIND_SOLAR_2000", "actual_text", CALCULATE( [Concentration Status], SelReportYear[year] = 2000, SelMode[mode_key] = "MODERN_WIND_SOLAR" ) & "" ),
    ROW( "test_id", "P5_B9_ENTRYCASE_Vietnam_HYDRO_ENTRY_STATUS", "actual_text", VAR _First = CALCULATE(
            MIN( FactEnergy[year] ),
            ALL( DimEntity ),
            DimEntity[entity] = "Vietnam",
            ALL( DimMetric ),
            DimMetric[metric_key] = "hydro_generation_twh",
            ALL( DimYear ),
            DimYear[is_main_asean_window] = 1,
            FactEnergy[value] > 0.0
        )
        RETURN
            SWITCH(
                TRUE(),
                ISBLANK( _First ), "NOT_OBSERVED_BY_2021",
                _First = 2000, "ACTIVE_AT_WINDOW_START",
                "OBSERVED_TRANSITION"
            ) & "" ),
    ROW( "test_id", "P5_B9_ENTRYCASE_Vietnam_SOLAR_ENTRY_STATUS", "actual_text", VAR _First = CALCULATE(
            MIN( FactEnergy[year] ),
            ALL( DimEntity ),
            DimEntity[entity] = "Vietnam",
            ALL( DimMetric ),
            DimMetric[metric_key] = "solar_generation_twh",
            ALL( DimYear ),
            DimYear[is_main_asean_window] = 1,
            FactEnergy[value] > 0.0
        )
        RETURN
            SWITCH(
                TRUE(),
                ISBLANK( _First ), "NOT_OBSERVED_BY_2021",
                _First = 2000, "ACTIVE_AT_WINDOW_START",
                "OBSERVED_TRANSITION"
            ) & "" ),
    ROW( "test_id", "P5_B9_ENTRYCASE_Brunei_SOLAR_ENTRY_STATUS", "actual_text", VAR _First = CALCULATE(
