// =====================================================================
// Phase 5 -- acceptance queries
// Generated by python\05_acceptance.py. DO NOT edit by hand.
//
// How to run: through MCP `dax_query_operations`, one EVALUATE block at a time.
// Set maxRows explicitly -- the largest block returns 54 rows and a default row
// cap silently truncates the result, which reads as missing tests.
// Collect every block into output\stats\05_test_results.tsv with the three
// columns `test_id`, `actual_value`, `actual_text`, then run:
//     python python\05_validate.py
//
// Reconciliation ALWAYS happens on the STORAGE scale of 03_fact_metrics.csv.
// Only share_electricity_pct is held on 0-100; every other ratio is on 0-1.
// Comparing a stored ratio of 0.671023268910 against a displayed 67.102326891
// is off by 66.43 -- that is a unit error, not a rounding difference.
//
// Method version: phase5_v1
// Phase 2 fingerprint: 64e1cc7d7bcbbde9f2378eaa81e5a42f4a1322d356a5a0b73f4cd944b95a8b10
// =====================================================================


// ---- Gate B2 -- numeric results (14 cells) ----
EVALUATE
UNION(
    ROW( "test_id", "P5_B2_FACT_ROWS", "actual_value", COUNTROWS( FactEnergy ) ),
    ROW( "test_id", "P5_B2_DIM_ENTITY_ROWS", "actual_value", COUNTROWS( DimEntity ) ),
    ROW( "test_id", "P5_B2_CURRENT_COUNTRY_N", "actual_value", CALCULATE( COUNTROWS( DimEntity ), DimEntity[is_current_country_or_territory] = 1 ) ),
    ROW( "test_id", "P5_B2_ASEAN_N", "actual_value", CALCULATE( COUNTROWS( DimEntity ), DimEntity[is_asean] = 1 ) ),
    ROW( "test_id", "P5_B2_NON_AGGREGATE_N", "actual_value", CALCULATE( COUNTROWS( DimEntity ), DimEntity[is_aggregate] = 0 ) ),
    ROW( "test_id", "P5_B2_DIM_METRIC_ROWS", "actual_value", COUNTROWS( DimMetric ) ),
    ROW( "test_id", "P5_B2_DIM_YEAR_ROWS", "actual_value", COUNTROWS( DimYear ) ),
    ROW( "test_id", "P5_B2_MAIN_WINDOW_N", "actual_value", CALCULATE( COUNTROWS( DimYear ), DimYear[is_main_asean_window] = 1 ) ),
    ROW( "test_id", "P5_B2_DUPLICATE_KEYS", "actual_value", COUNTROWS( FactEnergy ) - COUNTROWS( SUMMARIZE( FactEnergy, FactEnergy[entity], FactEnergy[year], FactEnergy[metric_key] ) ) ),
    ROW( "test_id", "P5_B2_NEGATIVE_VALUES", "actual_value", COUNTROWS( FILTER( FactEnergy, FactEnergy[value] < 0 ) ) + 0 ),
    ROW( "test_id", "P5_B2_YEAR_2022_ROWS", "actual_value", COUNTROWS( FILTER( FactEnergy, FactEnergy[year] = 2022 ) ) + 0 ),
    ROW( "test_id", "P5_B2_VALUES_OVER_4DP", "actual_value", COUNTROWS( FILTER( FactEnergy, ROUND( FactEnergy[value], 4 ) <> FactEnergy[value] ) ) + 0 ),
    ROW( "test_id", "P5_B2_RAW_ASEAN_10_2021", "actual_value", CALCULATE( [ASEAN Gen TWh], SelReportYear[year] = 2021, SelMode[mode_key] = "RENEWABLE_TOTAL" ) ),
    ROW( "test_id", "P5_B2_RAW_WORLD_REPORTED_2021", "actual_value", CALCULATE( [World Gen TWh], SelReportYear[year] = 2021, SelMode[mode_key] = "RENEWABLE_TOTAL" ) )
)


