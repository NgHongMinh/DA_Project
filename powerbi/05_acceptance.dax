            ), DIVIDE( [@Generation], [@Capacity] * 8.76 ) ), MINX( FILTER(
                ADDCOLUMNS(
                    CROSSJOIN(
                        CALCULATETABLE( VALUES( DimEntity[entity] ), ALL( DimEntity ), DimEntity[is_asean] = 1 ),
                        CALCULATETABLE( VALUES( DimYear[year] ), ALL( DimYear ), DimYear[is_main_asean_window] = 1 )
                    ),
