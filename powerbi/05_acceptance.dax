                        CALCULATETABLE( VALUES( DimYear[year] ), ALL( DimYear ), DimYear[is_main_asean_window] = 1 )
                    ),
                    "@Capacity",
                        CALCULATE(
                            SUM( FactEnergy[value] ),
                            ALL( DimMetric ),
                            DimMetric[metric_key] = "wind_capacity_gw"
                        ),
                    "@Generation",
                        CALCULATE(
                            SUM( FactEnergy[value] ),
                            ALL( DimMetric ),
                            DimMetric[metric_key] = "wind_generation_twh"
                        )
                ),
                [@Capacity] > 0 && NOT ISBLANK( [@Generation] )
            ), "@Country", DimEntity[entity] )
            )
        ) + 0 ),
    ROW( "test_id", "P5_B9_CF_PAIRS_SOLAR", "actual_value", COUNTROWS( FILTER(
                ADDCOLUMNS(
                    CROSSJOIN(
                        CALCULATETABLE( VALUES( DimEntity[entity] ), ALL( DimEntity ), DimEntity[is_asean] = 1 ),
                        CALCULATETABLE( VALUES( DimYear[year] ), ALL( DimYear ), DimYear[is_main_asean_window] = 1 )
                    ),
