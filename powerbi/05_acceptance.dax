                _First = 2000, "ACTIVE_AT_WINDOW_START",
                "OBSERVED_TRANSITION"
            ) & "" ),
    ROW( "test_id", "P5_B9_ENTRYCASE_Brunei_SOLAR_MATERIAL_ENTRY_STATUS", "actual_text", VAR _First = CALCULATE(
            MIN( FactEnergy[year] ),
            ALL( DimEntity ),
            DimEntity[entity] = "Brunei",
            ALL( DimMetric ),
            DimMetric[metric_key] = "solar_generation_twh",
            ALL( DimYear ),
